WEB_PORT=80
POSTGRES_PORT=5454

# Melhor Envio sandbox
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_USER_AGENT=r6tech_store (seu-email@example.com)

# AWS — região compartilhada por SES e S3 (somente produção)
AWS_REGION=us-east-1

# Amazon S3 — uploads do Active Storage (alternativa às credentials em aws.s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=r6tech-store-production

# Amazon SES (alternativa às credentials em aws.ses)
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# Mercado Pago (Checkout Pro). Use credenciais de teste (TEST-...) fora de produção.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
