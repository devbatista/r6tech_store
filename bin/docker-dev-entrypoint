#!/bin/bash -e

rm -f tmp/pids/server.pid

if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  if [ "${PREPARE_DB_ON_BOOT}" == "true" ]; then
    ./bin/rails db:prepare
  fi

  # Garante que app/assets/builds/application.css exista antes da primeira requisição.
  # O serviço `css` do docker-compose mantém o arquivo atualizado depois disso.
  ./bin/rails dartsass:build
fi

exec "${@}"
