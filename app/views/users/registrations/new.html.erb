<% content_for :title, "#{t("storefront.auth.sign_up_title")} | #{storefront_name}" %>

<section class="page-heading account-heading">
  <div class="store-container">
    <h1><%= t("storefront.auth.sign_up_title") %></h1>
  </div>
</section>

<section class="store-section auth-section">
  <div class="store-container">
    <div class="account-profile-form auth-form">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "account-profile-form__section" }) do |f| %>
        <h3><%= t("storefront.auth.sign_up_heading") %></h3>
        <p><%= t("storefront.auth.sign_up_hint") %></p>

        <%= render "users/shared/error_messages", resource: resource %>

        <div class="account-profile-form__grid">
          <label><%= t("storefront.account_page.name") %><%= f.text_field :name, required: true, autofocus: true, autocomplete: "name" %></label>
          <label><%= t("storefront.account_page.email") %><%= f.email_field :email, required: true, autocomplete: "email" %></label>
          <label><%= t("storefront.auth.password") %><%= f.password_field :password, required: true, autocomplete: "new-password", minlength: @minimum_password_length %></label>
          <label><%= t("storefront.account_page.password_confirmation") %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></label>
        </div>

        <%= f.submit t("storefront.auth.sign_up_submit"), class: "store-button store-button--dark" %>
      <% end %>

      <%= render "users/shared/links" %>
    </div>
  </div>
</section>
